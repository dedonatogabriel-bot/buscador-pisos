# Copiá este archivo a .env y completá los valores. Nunca subas .env al repo.
# Dónde se usa cada variable: PC = .env de la PC de Windows · GH = GitHub Secrets · SB = secretos de Supabase

# Supabase (G-04) — PC, GH
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# Entrada de avisos (C-06) — PC, GH, SB
INGEST_TOKEN=

# Telegram (G-05) — GH, SB
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_MARCOS=
TELEGRAM_CHAT_ID_GABI=

# MercadoLibre (G-07) — SB
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Firebase Hosting (G-11) — GH
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# Claude Code en GitHub Actions (G-08) — GH
CLAUDE_CODE_OAUTH_TOKEN=

# Opcional: visión con tope de US$5/mes (G-10) — PC
ANTHROPIC_API_KEY=
